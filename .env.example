# Django Environment Configuration
DJANGO_SECRET_KEY=django-insecure-enterprise-portfolio-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to sqlite3 if unset)
DB_ENGINE=sqlite3
# For PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=portfolio_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Email Settings (Defaults to console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For Production SMTP (e.g., SendGrid, Mailgun, Amazon SES):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key
# DEFAULT_FROM_EMAIL=portfolio@arvinagramon.com
